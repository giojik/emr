+    if (dto.sedation_drugs !== undefined) v.sedation_drugs = JSON.stringify(dto.sedation_drugs.filter((d) => d.drug?.trim()));
+    if (dto.monitoring !== undefined) v.monitoring = JSON.stringify(dto.monitoring.filter((x) => x.time));
