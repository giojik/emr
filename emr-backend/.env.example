NODE_ENV=development
PORT=3000

# runtime — აპლიკაციის როლი (audit_logs-ზე მხოლოდ INSERT/SELECT)
DATABASE_URL=postgresql://emr_app:EMR_APP_PASSWORD@127.0.0.1:5432/emr
# migration-ები და db:codegen — schema-ს მფლობელი
MIGRATION_DATABASE_URL=postgresql://emr_owner:POSTGRES_PASSWORD@127.0.0.1:5432/emr
DB_POOL_MAX=10

# --- JWT / სესიები ---
JWT_SECRET=                      # openssl rand -hex 32
JWT_ACCESS_TTL_SEC=900           # access token: 15 წთ
REFRESH_TTL_HOURS=12             # refresh (httpOnly cookie): ერთი ცვლა
COOKIE_SECURE=false              # dev (http) = false; production (https) = true

# --- Login პოლიტიკა ---
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# --- პროვაიდერები (კლინიკის კონფიგურაცია) ---
AUTH_LOCAL_ENABLED=true
AUTH_LDAP_ENABLED=false

# --- LDAP / Active Directory (საჭიროა მხოლოდ AUTH_LDAP_ENABLED=true-ზე) ---
LDAP_URL=ldaps://dc01.innovamedical.local:636
LDAP_BIND_TEMPLATE={username}@innovamedical.local
LDAP_BASE_DN=DC=innovamedical,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_REQUIRED_GROUP_DN=          # მაგ. CN=EMR-Users,OU=Groups,DC=innovamedical,DC=local (ცარიელი = ყველა)
LDAP_NESTED_GROUPS=true
LDAP_TLS_CA_FILE=                # შიდა CA (PEM), თუ DC-ის სერტიფიკატი შიდა CA-თია გაცემული
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=5000
