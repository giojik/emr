NODE_ENV=development
PORT=3000

# runtime — აპლიკაციის როლი (audit_logs-ზე მხოლოდ INSERT/SELECT)
DATABASE_URL=postgresql://emr_app:EMR_APP_PASSWORD@127.0.0.1:5432/emr
# migration-ები და db:codegen — schema-ს მფლობელი
MIGRATION_DATABASE_URL=postgresql://emr_owner:POSTGRES_PASSWORD@127.0.0.1:5432/emr

DB_POOL_MAX=10
